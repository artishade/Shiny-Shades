# ===================================================
# Shiny Shades — environment variables (Next.js)
#
# NEXT_PUBLIC_* vars are inlined into the browser bundle at build time —
# same role as Vite's VITE_* prefix, just renamed. Never put secrets
# (SSLCommerz store password, Supabase service role key, etc.) behind that prefix.
# Everything WITHOUT the NEXT_PUBLIC_ prefix is server-only (API routes,
# scripts/generate-sitemap.js) and never reaches the browser.
# ===================================================

# ── Supabase (client-side) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only — API routes, sitemap script) ─────────────────
# NOT the anon key — needs write access, keep secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (client-side uploads) ─────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_OG_FOLDER=
NEXT_PUBLIC_CLOUDINARY_OG_FILENAME=

# ── Tracking (client-side) ───────────────────────────────────────────────
# Both have hardcoded fallbacks in src/config/trackingConfig.ts if unset.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# ── SSLCommerz (server-only) ──────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# ── Site URL used to build absolute redirect/callback URLs (server-only) ─
PUBLIC_SITE_URL=https://shinyshades.vercel.app

# ── Google Sheets order logger webhook (server-only, optional) ──────────
GOOGLE_SHEET_URL=
